# Скопируй в .env (cp .env.example .env) и подставь значения при необходимости.

# Hugging Face токен — нужен для скачивания gated-датасета lmsys/lmsys-chat-1m
# (зайди на страницу датасета на huggingface.co и прими условия доступа).
# Токен: https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Опционально: ключ Tavily, если захочешь заменить DuckDuckGo на более качественный поиск.
# По умолчанию web_search использует DuckDuckGo и ключ НЕ требует.
# TAVILY_API_KEY=tvly-...

# ── agent_demo.ipynb: какой провайдер LLM использовать для ReAct-агента ──────
# openrouter | lmstudio | transformers (своя загрузка HF-модели, нужен torch/transformers/peft)
LLM_PROVIDER=lmstudio

# OpenRouter (есть бесплатные модели, OpenAI-совместимый API): https://openrouter.ai/keys
# Нужен только при LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=qwen/qwen3-next-80b-a3b-instruct:free

# LM Studio (локальный сервер, https://lmstudio.ai): вкладка Developer -> Start Server,
# загрузи модель и при необходимости поменяй значения ниже. Ключ не нужен.
# Нужны только при LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen/qwen3.5-9b
