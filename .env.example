# Скопируй этот файл в .env (в той же папке hw14) и подставь свой ключ OpenRouter.

# OpenRouter (OpenAI-совместимый API) — нужен для эмбеддингов и генерации ответа: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Подключение к Milvus (значения по умолчанию совпадают с docker-compose.yml).
# Менять не нужно, если поднимаешь Milvus локально через docker compose up -d.
MILVUS_HOST=localhost
MILVUS_PORT=19530
