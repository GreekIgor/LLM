# Скопируй этот файл в .env и подставь свой ключ.

# OpenRouter (OpenAI-совместимый API, есть бесплатные модели): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Опционально: переопределить модели и эндпоинт (значения по умолчанию см. в config.py)
# Генератор дешёвый (много вызовов), судья сильнее (достоверность метрик):
# RAGAS_GEN_MODEL=openai/gpt-4o-mini
# RAGAS_JUDGE_MODEL=openai/gpt-4o
# RAGAS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
