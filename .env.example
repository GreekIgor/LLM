# Скопируй этот файл в .env и подставь свои ключи

# Какой провайдер LLM использовать в ноутбуке: openrouter | lmstudio
LLM_PROVIDER=lmstudio

# OpenRouter (есть бесплатные модели, OpenAI-совместимый API): https://openrouter.ai/keys
# Нужен только если LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-...

# LM Studio (локальный сервер, https://lmstudio.ai): запусти Developer -> Start Server,
# загрузи модель (например google/gemma-3-4b) и при необходимости поменяй значения ниже.
# Нужны только если LLM_PROVIDER=lmstudio
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-4b

# Альтернативы (опционально; в ноутбуке отключены)
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# Langfuse (ключи берутся из Project Settings в дашборде Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU-регион: https://cloud.langfuse.com  |  US-регион: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
