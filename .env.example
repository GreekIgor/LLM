# Скопируй этот файл в .env и подставь свои ключи

# OpenRouter (есть бесплатные модели, OpenAI-совместимый API): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Альтернативы (опционально; в ноутбуке отключены)
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...

# Langfuse (ключи берутся из Project Settings в дашборде Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU-регион: https://cloud.langfuse.com  |  US-регион: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
