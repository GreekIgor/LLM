# Скопируй в .env и подставь свои ключи:  cp .env.example .env
# .env в .gitignore и в репозиторий не попадает.

# Какой провайдер LLM использовать: local | openrouter | lmstudio
#   local      — локальная HF-модель (авто-GPU, если есть; иначе CPU)
#   openrouter — облачные модели через OpenRouter (нужен OPENROUTER_API_KEY)
#   lmstudio   — локальный OpenAI-совместимый сервер
LLM_PROVIDER=local

# OpenRouter (есть бесплатные модели, OpenAI-совместимый API): https://openrouter.ai/keys
OPENROUTER_API_KEY=<YOUR_OPENROUTER_KEY>
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# LM Studio (локальный сервер, https://lmstudio.ai): Developer -> Start Server,
# загрузи модель (например google/gemma-3-4b) и при необходимости поменяй значения ниже.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-4b

# Альтернативы (опционально)
# OPENAI_API_KEY=<YOUR_OPENAI_KEY>
# GROQ_API_KEY=<YOUR_GROQ_KEY>

# Langfuse (ключи берутся из Project Settings в дашборде Langfuse)
LANGFUSE_PUBLIC_KEY=<YOUR_LANGFUSE_PUBLIC_KEY>
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
# EU-регион: https://cloud.langfuse.com  |  US-регион: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
